{
  "dependencies": {
    "@lydell/node-pty": "1.2.0-beta.15",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "monaco-editor": "^0.52.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "adm-zip": "^0.5.16",
    "@sunday/skills": "workspace:*",
    "@sunday/protocol": "workspace:*",
    "@sunday/context": "workspace:*",
    "@sunday/hooks": "workspace:*",
    "@sunday/orchestrator": "workspace:*",
    "@sunday/gateway": "workspace:*",
    "@sunday/org": "workspace:*"
  },
  "description": "Sunday IDE — Sunday's own custom IDE shell (Electron + React + Monaco). Zero VS Code workbench UI; Monaco is used only as the text-editing engine.",
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.1.2",
    "electron": "^37.2.0",
    "esbuild": "^0.24.0",
    "typescript": "^7.0.2",
    "vite": "^6.0.0",
    "vitest": "^3.0.0",
    "electron-builder": "^25.1.8"
  },
  "license": "Apache-2.0",
  "main": "dist-electron/main.cjs",
  "name": "@sunday/ide",
  "private": true,
  "scripts": {
    "build": "vite build && node scripts/build-electron.mjs",
    "build:electron": "node scripts/build-electron.mjs",
    "build:renderer": "vite build",
    "dev": "concurrently -k -n RENDERER,ELECTRON \"vite --port 5173 --strictPort\" \"node scripts/dev-electron.mjs\"",
    "lint": "eslint src electron scripts",
    "start": "electron .",
    "test": "vitest run",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.electron.json",
    "package:win": "electron-builder --win --config electron-builder.yml"
  },
  "type": "module",
  "version": "1.0.0"
}
