{
  "name": "sunday-agent",
  "displayName": "Sunday Agent",
  "version": "0.0.1",
  "private": true,
  "description": "Built-in extension: agent chat UI glue + tool executors needing the VS Code API. Talks JSON-RPC to the sundayd sidecar.",
  "publisher": "sunday",
  "engines": {
    "vscode": "^1.140.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./dist/extension.js",
  "scripts": {
    "build": "esbuild src/extension.ts --bundle --platform=node --format=cjs --outfile=dist/extension.js --external:vscode",
    "test": "echo 'extension tests run against the built fork (see \u00a724.1)'",
    "lint": "eslint src --ext .ts",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "contributes": {
    "commands": [
      {
        "command": "sunday.chat.focus",
        "title": "Focus Agent Chat",
        "category": "Sunday"
      },
      {
        "command": "sunday.manager.open",
        "title": "Open Agent Manager",
        "category": "Sunday"
      },
      {
        "command": "sunday.turn.stop",
        "title": "Stop Agent",
        "category": "Sunday"
      }
    ]
  },
  "devDependencies": {
    "esbuild": "^0.24.0"
  }
}
