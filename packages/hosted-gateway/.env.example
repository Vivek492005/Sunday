# Sunday hosted gateway — Railway deployment variables
# Copy these into the Railway service's Variables tab.

# --- Provider keys (operator's — YOU pay for inference) ---
# At least one is required. Groq is cheapest for Llama models.
OPENROUTER_API_KEY=
GROQ_API_KEY=

# --- Zero-config free tier (recommended) ---
# Users authenticate with their GitHub OAuth token from the IDE sign-in.
# No static keys needed. Quota is enforced per GitHub user per UTC day.
SUNDAY_HOSTED_GITHUB_AUTH=1
SUNDAY_HOSTED_DAILY_QUOTA=200

# --- Network ---
SUNDAY_HOSTED_HOST=0.0.0.0
SUNDAY_HOSTED_PORT=8080

# --- Abuse controls (tune to taste) ---
SUNDAY_HOSTED_RPM=60
SUNDAY_HOSTED_TPM=100000
SUNDAY_HOSTED_MAX_TOKENS=4096
# Comma-separated provider:model allowlist, e.g.:
# SUNDAY_HOSTED_MODELS=openrouter:meta-llama/llama-3.3-70b-instruct,groq:llama-3.3-70b-versatile
SUNDAY_HOSTED_MODELS=
SUNDAY_HOSTED_AUDIT_LOG=stdout
